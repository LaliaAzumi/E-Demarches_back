# ==========================================
# 1. BASE DE DONNÉES POSTGRESQL (OBLIGATOIRE)
# ==========================================
DB_NAME=commune_app
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# 2. SÉCURITÉ DJANGO (OBLIGATOIRE)
# ==========================================
# Générer une clé: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# 3. CORS - FRONTEND (OBLIGATOIRE)
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 4. INTERNATIONALISATION (OPTIONNEL)
# ==========================================
LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris
USE_I18N=True
USE_TZ=True

# ==========================================
# 5. API PAGINATION (OPTIONNEL)
# ==========================================
API_PAGE_SIZE=20

# ==========================================
# 6. REDIS / CELERY (OPTIONNEL)
# ==========================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================
# 7. EMAIL / SMTP (OPTIONNEL)
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=adrianostanislas2l@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@commune.fr

# ==========================================
# 8. CONSOLE EMAIL (DEV - Alternative au SMTP)
# ==========================================
# Décommenter pour tester les emails en console au lieu de SMTP
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==========================================
# 9. GOOGLE OAUTH (OPTIONNEL)
# ==========================================
# 1. Aller sur https://console.cloud.google.com/
# 2. Créer un projet → APIs & Services → Credentials
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter les URIs de redirection: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# 10. VÉRIFICATION EMAIL (CONFIGURÉ DANS ALLAUTH)
# ==========================================
# La vérification d'email est OBLIGATOIRE avant connexion (ACCOUNT_EMAIL_VERIFICATION = 'mandatory')
# L'utilisateur reçoit un email avec un lien de confirmation valable 3 jours
# Le lien confirme automatiquement l'email et connecte l'utilisateur
# Configuration des templates dans templates/account/email/

# ==========================================
# 11. FRONTEND URL (POUR LES LIENS D'EMAIL)
# ==========================================
# URL du frontend pour générer les liens de réinitialisation de mot de passe
FRONTEND_URL=http://localhost:3000
